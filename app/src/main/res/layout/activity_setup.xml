<?xml version="1.0" encoding="utf-8"?>
<!--
  One landscape screen, four focusable sections. No fragment navigation and no
  leanback presenter framework: a TV remote only needs up/down/left/right between a
  handful of rows, and plain focusable views keep this working on a phone too.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:orientation="vertical"
    android:padding="32dp"
    android:focusable="true">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@android:color/white"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/status_idle"
        android:textColor="#FFB35CEA"
        android:textSize="18sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="@android:color/black"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Recognizer -->
            <LinearLayout
                style="@style/Row"
                android:nextFocusDown="@id/row_mic"
                android:nextFocusUp="@id/row_model">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/section_status" />

                <TextView
                    android:id="@+id/recognizer_status"
                    style="@style/RowValue"
                    android:text="@string/status_idle" />

                <TextView
                    android:id="@+id/adb_hint"
                    style="@style/RowHint"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/row_mic"
                style="@style/Row"
                android:nextFocusDown="@id/row_model"
                android:nextFocusUp="@id/recognizer_status"
                android:text="@string/grant_mic_permission" />

            <!-- Model -->
            <LinearLayout
                android:id="@+id/row_model"
                style="@style/Row"
                android:nextFocusDown="@id/row_test"
                android:nextFocusUp="@id/row_mic">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/section_model" />

                <LinearLayout
                    android:id="@+id/model_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Test -->
            <LinearLayout
                android:id="@+id/row_test"
                style="@style/Row"
                android:nextFocusDown="@id/recognizer_status"
                android:nextFocusUp="@id/row_model">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/section_test" />

                <TextView
                    android:id="@+id/test_output"
                    style="@style/RowValue"
                    android:text="@string/status_idle" />

                <Button
                    android:id="@+id/test_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="true"
                    android:text="@string/run_test" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>