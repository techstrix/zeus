<?xml version="1.0" encoding="utf-8"?>
<!--
  One landscape screen, focusable rows, DPAD-native.

  No fragment navigation and no leanback presenter framework: a TV remote only
  needs up/down/left/right between a handful of rows, and plain focusable views
  keep this working on a phone too.

  The keyboard row is first because it is the path that needs nothing but this
  APK. The recogniser row is the deeper one that needs a computer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@android:color/white"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/status_idle"
        android:textColor="#FFB35CEA"
        android:textSize="18sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="@android:color/black"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Dictation keyboard: install-only path -->
            <LinearLayout
                android:id="@+id/row_keyboard"
                style="@style/Row"
                android:nextFocusDown="@id/row_recognizer"
                android:nextFocusUp="@id/row_test">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/section_keyboard" />

                <TextView
                    android:id="@+id/keyboard_status"
                    style="@style/RowValue"
                    android:text="@string/keyboard_not_enabled" />

                <TextView
                    android:id="@+id/keyboard_hint"
                    style="@style/RowHint"
                    android:text="@string/keyboard_step_one" />

                <Button
                    android:id="@+id/keyboard_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:focusable="true"
                    android:text="@string/enable_keyboard" />
            </LinearLayout>

            <!-- Default recogniser: needs adb -->
            <LinearLayout
                android:id="@+id/row_recognizer"
                style="@style/Row"
                android:nextFocusDown="@id/row_mic"
                android:nextFocusUp="@id/row_keyboard">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/section_status" />

                <TextView
                    android:id="@+id/recognizer_status"
                    style="@style/RowValue"
                    android:text="@string/status_idle" />

                <TextView
                    android:id="@+id/adb_hint"
                    style="@style/RowHint"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/row_mic"
                style="@style/Row"
                android:nextFocusDown="@id/row_model"
                android:nextFocusUp="@id/row_recognizer"
                android:text="@string/grant_mic_permission" />

            <!-- Model -->
            <LinearLayout
                android:id="@+id/row_model"
                style="@style/Row"
                android:nextFocusDown="@id/row_test"
                android:nextFocusUp="@id/row_mic">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/section_model" />

                <LinearLayout
                    android:id="@+id/model_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- Test -->
            <LinearLayout
                android:id="@+id/row_test"
                style="@style/Row"
                android:nextFocusDown="@id/row_keyboard"
                android:nextFocusUp="@id/row_model">

                <TextView
                    style="@style/RowTitle"
                    android:text="@string/section_test" />

                <TextView
                    android:id="@+id/test_output"
                    style="@style/RowValue"
                    android:text="@string/status_idle" />

                <Button
                    android:id="@+id/test_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:focusable="true"
                    android:text="@string/run_test" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>